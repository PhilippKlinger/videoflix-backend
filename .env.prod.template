# Prod template
DEBUG=False
SECRET_KEY=<strong-random-key>
ALLOWED_HOSTS=videoflix.philipp-klinger.com

# Frontend and API on one domain (no CORS, cookies SameSite=Strict)
CSRF_TRUSTED_ORIGINS=https://videoflix.philipp-klinger.com
FRONTEND_URL=https://videoflix.philipp-klinger.com

DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=db
DB_PORT=5432

REDIS_HOST=redis
REDIS_LOCATION=redis://redis:6379/1
REDIS_PORT=6379
REDIS_DB=0

# Reverse proxies in front of Django (Caddy = 1); 0 ignores X-Forwarded-For
TRUSTED_PROXY_COUNT=1

# Throttle rates stay at their strict defaults in production; only override on purpose:
# THROTTLE_RATE_LOGIN=5/min
# THROTTLE_RATE_AUTH_MAIL=5/hour
# THROTTLE_RATE_UPLOAD=10/hour
# THROTTLE_RATE_DEMO=5/hour

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email_user
EMAIL_HOST_PASSWORD=your_email_user_password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@example.com

# Enforce HTTPS (Caddy redirects as well)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

# Prod: do NOT create migrations automatically
RUN_MAKEMIGRATIONS=0

# Gunicorn (optional, defaults shown)
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=120

# Admin account once after the first start (no default accounts in the image):
# docker compose exec web python manage.py createsuperuser
