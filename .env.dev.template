# Dev template
DEBUG=True
SECRET_KEY=<strong-random-key>
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.178.64

CSRF_TRUSTED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
FRONTEND_URL=http://localhost:4200


DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=db
DB_PORT=5432

REDIS_HOST=redis
REDIS_LOCATION=redis://redis:6379/1
REDIS_PORT=6379
REDIS_DB=0

# Reverse proxies in front of Django; 0 without proxy (local), 1 behind Caddy
TRUSTED_PROXY_COUNT=0

# Mails go to Mailpit (http://localhost:8025); without Mailpit use:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=default_from_email

# Dev switches
RUN_MAKEMIGRATIONS=1
CREATE_SUPERUSER=1

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=<strong-admin-password>
DJANGO_SUPERUSER_EMAIL=admin@example.com
